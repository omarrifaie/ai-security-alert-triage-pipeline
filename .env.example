# PostgreSQL connection string used by SQLAlchemy and Alembic.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage

# OpenAI credentials and model selection used by the triage agent.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# Dashboard configuration.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_RELOAD=false

# Optional repository identifier stored on each scan record.
DEFAULT_REPOSITORY=local/dev

# Logging level for the CLI and dashboard (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
